# Copy this file to .env and fill in your own keys. Never commit .env.

# PostgreSQL connection string (Neon or any Postgres)
DATABASE_URL=

# Kinde authentication - https://kinde.com
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=https://<your-kinde-domain>.kinde.com
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000/dashboard

# UploadThing file storage (v7 uses a single token) - https://uploadthing.com/dashboard
UPLOADTHING_TOKEN=

# OpenAI embeddings and answers - https://platform.openai.com
OPENAI_API_KEY=

# Pinecone vector database (index name: dekge) - https://www.pinecone.io
PINECONE_API_KEY=

# Stripe billing in test mode - https://stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
