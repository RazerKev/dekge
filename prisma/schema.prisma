// NOTE - when doing local changes in this file, always push them in database first and then generate local types using "npx prisma db push" to push changes in DB and "npx prisma generate" to generate local typescript

// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note - Since PlanetScale is removing their free data DB schema, have to migrate elsewhere so choose Neon DB but will have to migrate from MySQL to PosgresQL
datasource db {
  // Changed from "mysql" to "postgresql"
  // provider     = "mysql" // Changed to mysql
  provider = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// Database model the user is synchronize to when log in. Once set up, do 'npx prisma db push' as follow on docs to force it in cloud.
model User {
  id    String @id @unique // Comes from authenticaiton provider so no '@defualt' as the docs. We're using same 'id' matches Kinde user 'id'
  email String @unique

  // Each User having multiple Files
  File    File[] // Each user can have multiple files in Array of files
  // Each user can send a bunch of message so a message array
  Message Message[]

  // Stripe Part for each user
  stripeCustomerId       String?   @unique @map(name: "stripe_customer_id") // Optional with '?' b/c not every user will be a customer
  stripeSubscriptionId   String?   @unique @map(name: "stripe_subscription_id")
  stripePriceId          String?   @map(name: "stripe_price_id")
  stripeCurrentPeriodEnd DateTime? @map(name: "stripe_current_period_end")
}

enum UploadStatus {
  // Status for file upload
  PENDING
  PROCESSING
  FAILED
  SUCCESS
}

model File {
  id   String @id @default(cuid()) // Prisma will generate the ID automatically
  name String

  uploadStatus UploadStatus @default(PENDING)

  // Each file will contain a URL
  url      String
  key      String
  messages Message[]

  //// New field for getting the number of pages to even determine if the document uploaded should be processed
  pageAmt  Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Prisma added these two lines in relatioin when added "File File[]" below when using Prettier
  User   User?   @relation(fields: [userId], references: [id])
  userId String?

  @@index([userId])
}

// Message model for "src\app\api\message\route.ts" for the user
model Message {
  id   String @id @default(cuid())
  // Each message has a text
  text String @db.Text()

  // Differentiate between user messages and AI answers
  isUserMessage Boolean

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?
  File      File?    @relation(fields: [fileId], references: [id])
  fileId    String?
}
